#!/usr/bin/env ruby

require "open3"

VER = /\d+\.\d+[\.\d]*\w*/

COMMAND = {
  "claude" => { bin: "claude", cmd: "claude --version", re: /(#{VER})/ },
  "fish" => { bin: "fish", cmd: "fish --version", re: /(#{VER})/ },
  "go" => { bin: "go", cmd: "go version", re: /(go#{VER})/ },
  "haskell" => { bin: "ghci", cmd: "ghci --version", re: /(#{VER})/ },
  "node" => { bin: "node", cmd: "node --version", re: /(v#{VER})/ },
  "nvim" => { bin: "nvim", cmd: "nvim --version | head -1 | grep .", re: /(v#{VER})/ },
  "parallel" => { bin: "parallel", cmd: "parallel --version | head -1 | grep .", re: /(\d{6,})/ },
  "postgres" => { bin: "postgres", cmd: "postgres --version", re: /(#{VER})/ },
  "python" => { bin: "python", cmd: "python --version", re: /(#{VER})/ },
  "ruby" => { bin: "ruby", cmd: "ruby --version", re: /(#{VER})/ },
  "rust" => { bin: "rustc", cmd: "rustc --version", re: /(#{VER})/ },
  "tmux" => { bin: "tmux", cmd: "tmux -V", re: /(#{VER})/ },
}

def extract_version(str, re)
  str[re, 1] || str
end

def which_path(c)
  bin = COMMAND.fetch(c)[:bin]
  stdout, _, status = Open3.capture3("which", bin)
  status.success? ? stdout.chomp : nil
end

def output(c)
  entry = COMMAND.fetch(c)
  stdout, _stderr, status = Open3.capture3(entry[:cmd])

  unless status.success?
    return `gum style --foreground 8 N/A`.chomp
  end

  extract_version(stdout.chomp, entry[:re])
rescue StandardError
  `gum style --foreground 8 N/A`.chomp
end

arg = ARGV[0] || ""
candidates = COMMAND.keys.select { |c| c.start_with?(arg) }

if candidates.size == 0
  exit 1
end

just_val = candidates.map(&:size).max + 2

results = candidates.map do |c|
  Thread.new do
    ver = output(c)
    path = which_path(c)
    just_name = c.ljust(just_val)
    name = `gum style --foreground 12 "#{just_name}"`.chomp
    dimmed_path = path ? `gum style --foreground 8 "#{path}"`.chomp : ""
    { name: name, ver: ver, ver_len: ver.gsub(/\e\[[^m]*m/, "").size, path: dimmed_path }
  end
end.map(&:value)

ver_width = results.map { |r| r[:ver_len] }.max + 2

results.each do |r|
  padded_ver = r[:ver] + " " * (ver_width - r[:ver_len])
  puts "#{r[:name]} #{padded_ver}#{r[:path]}"
end
